{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "${workspaceFolder}/*.cpp",
                "${workspaceFolder}/Core/*.cpp",
                "${workspaceFolder}/Models/*.cpp",
                "${workspaceFolder}/Procedures/*.cpp",
                "${workspaceFolder}/Infrastructure/*.cpp",
                "-o",
                "${workspaceFolder}/main.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Kompilacja wszystkich plików projektu za pomocą g++"
        }
    ],
    "version": "2.0.0"}